{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "site": {
      "root": "site"
    },
    "legacy_api": {
      "root": "archive/v1_droplet/droplet_app",
      "framework": "fastapi",
      "entrypoint": "api.py"
    }
  },
  "rewrites": [
    { "source": "/v1/api/(.*)", "destination": { "service": "legacy_api" } },
    { "source": "/(.*)", "destination": { "service": "site" } }
  ]
}
